<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- 左上：代號、名稱 -->
        <TextView
            android:id="@+id/tv_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2330" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tv_closing_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_code"
            tools:text="台積電" />

        <!-- 右上：收盤價、漲跌 -->
        <TextView
            android:id="@+id/tv_closing_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1,055.00"
            tools:textColor="@color/stock_up" />

        <TextView
            android:id="@+id/tv_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_closing_price"
            tools:text="▲ 15.00 (1.44%)"
            tools:textColor="@color/stock_up" />

        <!-- 上方區塊的底部：取名稱與漲跌兩者中較低的那個 -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_header_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_name,tv_change" />

        <!-- 月平均價，以及收盤價與月均價的比較標籤 -->
        <TextView
            android:id="@+id/tv_label_monthly_average"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_monthly_average"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="@id/tv_monthly_average_tag"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_monthly_average_tag" />

        <TextView
            android:id="@+id/tv_monthly_average_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintBottom_toBottomOf="@id/tv_monthly_average_tag"
            app:layout_constraintStart_toEndOf="@id/tv_label_monthly_average"
            app:layout_constraintTop_toTopOf="@id/tv_monthly_average_tag"
            tools:text="1,032.50" />

        <TextView
            android:id="@+id/tv_monthly_average_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_trend_tag"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/stock_tag_text"
            app:layout_constraintStart_toEndOf="@id/tv_monthly_average_price"
            app:layout_constraintTop_toBottomOf="@id/barrier_header_bottom"
            tools:backgroundTint="@color/stock_up"
            tools:text="@string/tag_above_monthly_average" />

        <com.google.android.material.divider.MaterialDivider
            android:id="@+id/div_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_monthly_average_tag" />

        <!-- 開盤、最高、最低、成交量：用 Guideline 平均切成四欄 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_column_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.25" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_column_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/gl_column_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.75" />

        <TextView
            android:id="@+id/tv_label_opening_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_opening_price"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/div_header" />

        <TextView
            android:id="@+id/tv_opening_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="@id/tv_label_opening_price"
            app:layout_constraintTop_toBottomOf="@id/tv_label_opening_price"
            tools:text="1,045.00" />

        <TextView
            android:id="@+id/tv_label_highest_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_highest_price"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/gl_column_2"
            app:layout_constraintTop_toTopOf="@id/tv_label_opening_price" />

        <TextView
            android:id="@+id/tv_highest_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="@id/tv_label_highest_price"
            app:layout_constraintTop_toBottomOf="@id/tv_label_highest_price"
            tools:text="1,060.00" />

        <TextView
            android:id="@+id/tv_label_lowest_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_lowest_price"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/gl_column_3"
            app:layout_constraintTop_toTopOf="@id/tv_label_opening_price" />

        <TextView
            android:id="@+id/tv_lowest_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="@id/tv_label_lowest_price"
            app:layout_constraintTop_toBottomOf="@id/tv_label_lowest_price"
            tools:text="1,040.00" />

        <TextView
            android:id="@+id/tv_label_trade_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_trade_volume"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="@id/gl_column_4"
            app:layout_constraintTop_toTopOf="@id/tv_label_opening_price" />

        <TextView
            android:id="@+id/tv_trade_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="@id/tv_label_trade_volume"
            app:layout_constraintTop_toBottomOf="@id/tv_label_trade_volume"
            tools:text="32,451" />

        <!-- 成交筆數、成交金額 -->
        <TextView
            android:id="@+id/tv_transaction_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_opening_price"
            tools:text="@string/format_transaction_count" />

        <TextView
            android:id="@+id/tv_trade_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_transaction_count"
            app:layout_constraintStart_toEndOf="@id/tv_transaction_count"
            tools:text="@string/format_trade_value" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
