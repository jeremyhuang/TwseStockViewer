<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 列表標題列的字體樣式，要調整字級改這裡即可 -->
    <style name="TextAppearance.TwseStockViewer.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.TwseStockViewer.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
    </style>

    <!-- 標題列下方條件 chip 的文字 -->
    <style name="TextAppearance.TwseStockViewer.QueryChip" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 膠囊形狀（兩端全圓） -->
    <style name="ShapeAppearance.TwseStockViewer.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 排序 chip：實心淺藍底、藍字、前面有方向箭頭、沒有外框 -->
    <style name="Widget.TwseStockViewer.Chip.Sort" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipIconSize">16dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAppearance">@style/TextAppearance.TwseStockViewer.QueryChip</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TwseStockViewer.Pill</item>
    </style>

    <!-- 篩選條件 chip：白底、灰色外框、後面有 × -->
    <style name="Widget.TwseStockViewer.Chip.Filter" parent="Widget.Material3.Chip.Input">
        <item name="android:checkable">false</item>
        <item name="chipBackgroundColor">?attr/colorSurface</item>
        <item name="chipStrokeColor">@color/query_chip_stroke</item>
        <item name="closeIconVisible">true</item>
        <item name="closeIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.TwseStockViewer.QueryChip</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.TwseStockViewer.Pill</item>
    </style>

    <!-- 排序與篩選 Bottom Sheet 的主題：Material 的 Sheet 背景設為透明，背景與圓角完全交給 Compose 的 Surface。
         Material 的 Sheet 背景會依展開狀態、狀態列 inset 調整位置與圓角，還會疊上一層 primary 色的 elevation 色調，
         跟 Compose 內容的大小不一定一致；切換選項重新排版時兩者錯開，就會在面板上方露出一塊色塊。
         只能從樣式設定：BottomSheetBehavior 每次排版都會重設背景，在程式碼裡設成 null 會被蓋掉。 -->
    <style name="ThemeOverlay.TwseStockViewer.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TwseStockViewer.BottomSheet</item>
    </style>

    <style name="Widget.TwseStockViewer.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
</resources>
